{
    "name": "gowork/safe",
    "description": "Type Safety Tools",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.5",
        "dazet/type-utils": "^0.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "symfony/console": "^8.1",
        "symfony/http-kernel": "^8.1",
        "symfony/error-handler": "^8.1",
        "phpstan/phpstan": "^2.2"
    },
    "autoload": {
        "psr-4": {
            "GW\\Safe\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "tests\\GW\\Safe\\": "tests/"
        }
    },
    "scripts": {
        "phpstan": "phpstan analyse",
        "test": "phpunit"
    }
}
